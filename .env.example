# Copy to .env.local and paste your Neon connection strings.
# .env.local is gitignored and must never be committed.
#
# Use the POOLED strings from the Neon dashboard — the host contains
# "-pooler". The direct host works locally but exhausts connections on
# serverless functions.

# Least-privilege runtime role. Can read and write rows; cannot create or
# drop tables. This is the one that goes into Vercel.
DATABASE_URL=

# Schema owner, used for migrations only. Keep this OUT of Vercel — nothing
# the app serves at runtime should be able to drop a table.
MIGRATION_DATABASE_URL=
