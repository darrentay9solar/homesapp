# Copy to .env.local and fill in. .env.local is gitignored; never commit it.
#
# Use the POOLED strings from Neon (host contains "-pooler"). The direct host
# works locally but exhausts connections on serverless functions.
#
# The DEFAULT pair points at the DEVELOPMENT branch on purpose: anything run
# without thinking hits a database you can afford to break. Production must be
# named explicitly, e.g.
#   npm run db:app-role -- --key=PROD_MIGRATION_DATABASE_URL

# --- development branch (default) ---
# Least-privilege runtime role. Goes into Vercel's Preview + Development.
DATABASE_URL=
# Schema owner, for migrations. Never goes into Vercel.
MIGRATION_DATABASE_URL=

# --- production branch (explicit targeting only) ---
# Already set in Vercel for the Production environment.
PROD_DATABASE_URL=
PROD_MIGRATION_DATABASE_URL=

# --- public URL used in emails and WhatsApp links ---
# Optional. On Vercel the production domain is detected automatically.
APP_URL=

# --- file storage: Cloudflare R2 (see docs/r2.md) ---
# Separate buckets per environment, like the Neon branches:
# gethomeapps-dev here and in Vercel Preview/Development, gethomeapps-prod in
# Vercel Production only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- email: Resend (see docs/whatsapp.md, "Email" section) ---
# EMAIL_FROM must use a domain verified in Resend, e.g.
#   9 Solar Home <noreply@yourdomain.sg>
RESEND_API_KEY=
EMAIL_FROM=

# --- WhatsApp: Meta Cloud API (see docs/whatsapp.md) ---
# A permanent System User token, not the 24-hour one from the getting-started page.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional overrides.
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANG=en

# --- SMS fallback: Twilio (see docs/whatsapp.md, "SMS fallback") ---
# Only used when WhatsApp can't deliver. SMS_FROM is a Messaging Service SID
# (MG...) or a sender name registered with SGNIC's SMS Sender ID Registry.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_FROM=

# --- local responsive/e2e testing (development Clerk instance only) ---
# Created with: clerk users create --email ...+clerk_test@example.com
# Clerk test addresses accept the fixed verification code 424242.
# Never set these in Vercel.
E2E_TEST_EMAIL=
E2E_TEST_USERNAME=
E2E_TEST_PASSWORD=

# Neon "test" branch — automated tests (npm run test:py) and the db:verify-*
# scripts write throwaway accounts and changes here, so the dev branch you
# click around in keeps a readable audit log. Same two roles as above.
TEST_DATABASE_URL=
TEST_MIGRATION_DATABASE_URL=
