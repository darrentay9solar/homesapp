# Copy to .env.local and fill in. .env.local is gitignored; never commit it.
#
# Use the POOLED strings from Neon (host contains "-pooler"). The direct host
# works locally but exhausts connections on serverless functions.
#
# The DEFAULT pair points at the DEVELOPMENT branch on purpose: anything run
# without thinking hits a database you can afford to break. Production must be
# named explicitly, e.g.
#   npm run db:app-role -- --key=PROD_MIGRATION_DATABASE_URL

# --- development branch (default) ---
# Least-privilege runtime role. Goes into Vercel's Preview + Development.
DATABASE_URL=
# Schema owner, for migrations. Never goes into Vercel.
MIGRATION_DATABASE_URL=

# --- production branch (explicit targeting only) ---
# Already set in Vercel for the Production environment.
PROD_DATABASE_URL=
PROD_MIGRATION_DATABASE_URL=

# --- local responsive/e2e testing (development Clerk instance only) ---
# Created with: clerk users create --email ...+clerk_test@example.com
# Clerk test addresses accept the fixed verification code 424242.
# Never set these in Vercel.
E2E_TEST_EMAIL=
E2E_TEST_USERNAME=
E2E_TEST_PASSWORD=
